# ==============================================================================
# VIBHA EdTech Platform - Environment Configuration Specification
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in production or local environments:
#    cp .env.example .env
# 2. Never commit active secrets, API keys, or production passwords to git.
# 3. In production, always set DEBUG=false and generate a secure 64-char SECRET_KEY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="VIBHA EdTech Platform"
VERSION=1.0.0
# Options: development, staging, production
ENVIRONMENT=development
# Set to false in staging and production to prevent internal stack trace leakage
DEBUG=true

# ------------------------------------------------------------------------------
# 2. SECURITY, SESSIONS & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Generate a secure 64-character random key: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=vibha-edtech-development-secret-key-change-in-production-2026
ALGORITHM=HS256
# Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Brute-force & Credential Stuffing Defense
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
MASKED_LOGGING_ENABLED=true

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary Database Backend: "firebase" (Google Cloud Firestore), "sqlite", or "postgres"
DATABASE_BACKEND=firebase
DATABASE_URL=sqlite:///./vibha.db

# Firebase Cloud Firestore Configuration
FIREBASE_ENABLED=true
# Path to your Firebase service account private key JSON
FIREBASE_CREDENTIALS_PATH=firebase-key.json
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=bhavani

# Option B: High-throughput PostgreSQL (recommended for production Docker setup)
# POSTGRES_USER=vibha_user
# POSTGRES_PASSWORD=vibha_secure_production_password
# POSTGRES_DB=vibha_db
# DATABASE_URL=postgresql+psycopg2://vibha_user:vibha_secure_production_password@localhost:5432/vibha_db

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (Comma-separated whitelist)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 5. AI INTELLIGENCE LAYER & LLM CONFIGURATION
# ------------------------------------------------------------------------------
# Master switch for AI Tutor, Course Document Assistant (RAG), and Question Generator
AI_ENABLED=true
# Provider options: "mock" (offline-first zero cost), "openai", "gemini"
AI_PROVIDER=mock
AI_MODEL_NAME=vibha-ai-deterministic-v1

# External Provider API Keys (leave blank if AI_PROVIDER=mock)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Usage Quotas & Reliability Guardrails
AI_DAILY_TOKEN_QUOTA_PER_USER=50000
AI_REQUEST_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
FILE_STORAGE_PATH=./uploads

# ------------------------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Base API endpoint accessed by the Next.js frontend browser client
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# In production behind Nginx:
# NEXT_PUBLIC_API_URL=/api/v1
